{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.16.0",
    "concurrently": "^10.0.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.30.4",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "concurrently \"npx @tailwindcss/cli -i ./src/index.css -o ./src/tailwind-compiled.css --watch\" \"react-scripts start\"",
    "build": "npx @tailwindcss/cli -i ./src/index.css -o ./src/tailwind-compiled.css --minify && react-scripts build",
    "test": "react-scripts test --watch=false",
    "test:watch": "react-scripts test",
    "test:coverage": "react-scripts test --watch=false --coverage --watchAll=false",
    "test:frontend": "react-scripts test --watch=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
