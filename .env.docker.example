# =============================================================================
# Gully News — Docker Environment Variables
# =============================================================================
# Copy this file to backend/.env and fill in real values before running:
#   cp .env.docker.example backend/.env
#
# The DATABASE_URL field is intentionally left blank for Docker Compose.
# DB_HOST is overridden by docker-compose.yml to point to the postgres service.
# =============================================================================

# Server
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# Leave DATABASE_URL empty when using the local Docker postgres service.
# docker-compose.yml injects DB_HOST=postgres automatically.
DATABASE_URL=

# Local Docker PostgreSQL (set in docker-compose.yml; override here if needed)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=neondb
DB_HOST=postgres
DB_PORT=5432

# Cloudinary — required for image upload feature
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
